# Endereço da cardvoz-api, com /api no final. Gravado no build: mudou, gere o site de novo.
# A API precisa liberar o endereço deste painel em CORS_ALLOWED_ORIGINS.
NEXT_PUBLIC_API_URL=http://localhost:5000/api
# Opcional: entrar com Google (o mesmo ID de cliente do site do CardVoz). Cadastre
# http://localhost:3001/entrar/ e https://<painel>/entrar/ no cliente OAuth do Google.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
